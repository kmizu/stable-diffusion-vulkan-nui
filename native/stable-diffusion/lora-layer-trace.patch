+#ifndef SD_LORA_LAYER_TRACE_H
+#define SD_LORA_LAYER_TRACE_H
+
+#include <cstddef>
+#include <unordered_map>
+#include <vector>
+
+#include "ggml.h"
+
+namespace sd {
+    // A predictor can submit several graphs. Count layer outputs only in
+    // successfully submitted graphs that actually use the LoRA operation.
+    class LoraLayerTrace {
+        inline static thread_local LoraLayerTrace* current_ = nullptr;
+        LoraLayerTrace* previous_;
+        std::unordered_map<const ggml_tensor*, std::vector<size_t>> outputs_;
+
+    public:
+        static constexpr size_t untracked = static_cast<size_t>(-1);
+        std::vector<size_t> counts;
+
+        LoraLayerTrace() : previous_(current_) { current_ = this; }
+        ~LoraLayerTrace() { current_ = previous_; }
+        LoraLayerTrace(const LoraLayerTrace&) = delete;
+        LoraLayerTrace& operator=(const LoraLayerTrace&) = delete;
+
+        static LoraLayerTrace* current() { return current_; }
+        void begin_graph() { outputs_.clear(); }
+
+        void mark(const ggml_tensor* output, const std::vector<size_t>& slots) {
+            if (!slots.empty())
+                outputs_[output].insert(outputs_[output].end(), slots.begin(), slots.end());
+        }
+
+        void commit(ggml_cgraph* graph) {
+            if (outputs_.empty())
+                return;
+            for (int i = 0; i < ggml_graph_n_nodes(graph); ++i) {
+                const auto found = outputs_.find(ggml_graph_node(graph, i));
+                if (found == outputs_.end())
+                    continue;
+                for (size_t slot : found->second) {
+                    if (slot >= counts.size())
+                        counts.resize(slot + 1, 0);
+                    ++counts[slot];
+                }
+            }
+            outputs_.clear();
+        }
+    };
+}
+
+#endif
