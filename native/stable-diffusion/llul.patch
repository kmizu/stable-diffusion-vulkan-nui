+#include "model/common/llul.h"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <map>
+#include <regex>
+#include <stdexcept>
+#include <tuple>
+
+#include "core/ggml_runner.h"
+#include "model/common/nui_unet_hooks.hpp"
+
+namespace sd::nui {
+    constexpr int LlulArea = 5;
+
+    struct LlulGraphData {
+        std::map<std::tuple<int, int, int, int, int, bool, int>, std::vector<float>> matrices;
+        ggml_tensor* mask = nullptr;
+    };
+
+    static std::string layer_label(const std::string& name, LlulLayer kind) {
+        static const std::regex pattern(R"((input_blocks|output_blocks)\.([0-9]+)\.([01])|middle_block\.([012]))");
+        static const std::regex depth_pattern(R"(transformer_blocks\.([0-9]+))");
+        std::smatch match;
+        if (!std::regex_search(name, match, pattern))
+            return {};
+        const auto two = [](int n) { return (n < 10 ? "0" : "") + std::to_string(n); };
+        const bool middle = match[4].matched;
+        int index = middle ? 0 : std::stoi(match[2].str());
+        int slot = kind == LlulResblock && middle && match[4].str() == "2" ? 1 : 0;
+        auto label = (middle ? "M" : match[1].str() == "input_blocks" ? "IN" : "OUT") + two(index) + "_" + two(slot);
+        if (kind == LlulResblock)
+            return label + "_resblock";
+        if (kind == LlulTransformer)
+            return label + "_trans";
+        if (!std::regex_search(name, match, depth_pattern))
+            return {};
+        return label + "_" + two(std::stoi(match[1].str())) + (kind == LlulSelf ? "_sattn" : "_xattn");
+    }
+
+    static double interpolation_kernel(double distance, int mode, bool antialias) {
+        distance = std::abs(distance);
+        if (mode == LlulBilinear)
+            return std::max(0., 1. - distance);
+        const double a = antialias ? -.5 : -.75;
+        if (distance < 1.)
+            return ((a + 2.) * distance - (a + 3.)) * distance * distance + 1.;
+        if (distance < 2.)
+            return ((a * distance - 5. * a) * distance + 8. * a) * distance - 4. * a;
+        return 0.;
+    }
+
+    static ggml_tensor* resize_axis(GGMLRunnerContext& ctx, ggml_tensor* input, int target,
+                                    int before, int after, int mode, bool aa, int step) {
+        const int source = int(input->ne[0]);
+        if (source == target && before == 0 && after == 0)
+            return input;
+        const int output = target + before + after;
+        auto& cache = active.llul_graph->matrices;
+        auto [slot, build] = cache.try_emplace({source, target, before, after, mode, aa, step});
+        auto& weights = slot->second;
+        if (build) {
+            weights.resize(size_t(source) * output);
+            const double scale = step > 0 ? step : double(source) / target;
+            const double kernel_scale = aa ? std::max(1., scale) : 1.;
+            const double support = (mode == LlulBicubic ? 2. : 1.) * kernel_scale;
+            for (int j = 0; j < output; ++j) {
+                const int position = std::clamp(j - before, 0, target - 1);
+                auto* row = weights.data() + size_t(j) * source;
+                if (mode == LlulArea) {
+                    // Adaptive average pooling includes overlapping edge bins on odd grids.
+                    const int first = int(int64_t(position) * source / target);
+                    const int last = int((int64_t(position + 1) * source + target - 1) / target);
+                    std::fill(row + first, row + last, 1.f / (last - first));
+                    continue;
+                }
+                if (mode == LlulNearest) {
+                    row[std::clamp(int(std::floor((position + .5) * scale)), 0, source - 1)] = 1.f;
+                    continue;
+                }
+                const double centre = (position + .5) * scale - .5;
+                double sum = 0;
+                for (int k = int(std::floor(centre - support)); k <= int(std::ceil(centre + support)); ++k) {
+                    if (aa && (k < 0 || k >= source))
+                        continue;
+                    const double weight = interpolation_kernel((k - centre) / kernel_scale, mode, aa);
+                    row[std::clamp(k, 0, source - 1)] += float(weight);
+                    sum += weight;
+                }
+                for (int k = 0; k < source; ++k)
+                    row[k] = float(row[k] / sum);
+            }
+        }
+        auto* graph = ctx.ggml_ctx;
+        auto* kernel = ggml_new_tensor_2d(graph, GGML_TYPE_F32, source, output);
+        ctx.set_backend_tensor_data(kernel, weights.data());
+        return ggml_mul_mat(graph, kernel, input);
+    }
+
+    static ggml_tensor* resize(GGMLRunnerContext& ctx, ggml_tensor* input, int w, int h,
+                               int pad_w, int pad_h, int mode, bool aa, int step = 0) {
+        auto* graph = ctx.ggml_ctx;
+        auto* x = resize_axis(ctx, input, w, pad_w / 2, pad_w - pad_w / 2, mode, aa, step);
+        if (x->ne[1] == h && !pad_h)
+            return x;
+        x = ggml_cont(graph, ggml_transpose(graph, x));
+        x = resize_axis(ctx, x, h, pad_h / 2, pad_h - pad_h / 2, mode, aa, step);
+        return ggml_cont(graph, ggml_transpose(graph, x));
+    }
+
+    static ggml_tensor* crop(ggml_context* graph, ggml_tensor* image, int x, int y, int w, int h) {
+        return ggml_view_4d(graph, image, w, h, image->ne[2], image->ne[3],
+                            image->nb[1], image->nb[2], image->nb[3], x * image->nb[0] + y * image->nb[1]);
+    }
+
+    static int region_origin(int size, int extent, double fraction) {
+        const double value = size * fraction;
+        if (value <= -1.)
+            throw std::runtime_error("LLuL region starts outside the image");
+        return int(std::clamp(value, 0., double(size - extent)));
+    }
+
+    static ggml_tensor* spherical(ggml_context* g, ggml_tensor* low, ggml_tensor* high, float weight) {
+        const auto pack = [&](ggml_tensor* t) { return ggml_cont(g, ggml_permute(g, t, 1, 2, 0, 3)); };
+        auto* a = pack(low);
+        auto* b = pack(high);
+        auto* an = ggml_sqrt(g, ggml_sum_rows(g, ggml_sqr(g, a)));
+        auto* bn = ggml_sqrt(g, ggml_sum_rows(g, ggml_sqr(g, b)));
+        constexpr auto max = std::numeric_limits<float>::max();
+        auto* denom = ggml_clamp(g, ggml_mul(g, an, bn), 1e-30f, max);
+        auto* dot = ggml_clamp(g, ggml_div(g, ggml_sum_rows(g, ggml_mul(g, a, b)), denom), -1.f, 1.f);
+        auto* x = ggml_abs(g, dot);
+        // Minimax acos approximation on [0, 1], reflected for negative dot products.
+        auto* poly = ggml_scale_bias(g, x, -.0187293f, .0742610f);
+        poly = ggml_scale_bias(g, ggml_mul(g, poly, x), 1.f, -.2121144f);
+        poly = ggml_scale_bias(g, ggml_mul(g, poly, x), 1.f, 1.5707288f);
+        auto* acute = ggml_mul(g, poly, ggml_sqrt(g, ggml_scale_bias(g, x, -1.f, 1.f)));
+        auto* negative = ggml_step(g, ggml_scale(g, dot, -1.f));
+        auto* angle = ggml_add(g, acute, ggml_mul(g, negative, ggml_scale_bias(g, acute, -2.f, 3.141592653589793f)));
+        auto* sine = ggml_abs(g, ggml_sin(g, angle));
+        auto* nonzero = ggml_step(g, ggml_scale_bias(g, sine, 1.f, -1e-6f));
+        nonzero = ggml_mul(g, nonzero, ggml_step(g, ggml_mul(g, an, bn)));
+        auto* safe = ggml_clamp(g, sine, 1e-6f, max);
+        auto* wa = ggml_div(g, ggml_sin(g, ggml_scale(g, angle, 1.f - weight)), safe);
+        auto* wb = ggml_div(g, ggml_sin(g, ggml_scale(g, angle, weight)), safe);
+        auto* curved = ggml_add(g, ggml_mul(g, a, wa), ggml_mul(g, b, wb));
+        auto* linear = ggml_add(g, a, ggml_scale(g, ggml_sub(g, b, a), weight));
+        auto* blended = ggml_add(g, linear, ggml_mul(g, ggml_sub(g, curved, linear), nonzero));
+        return ggml_cont(g, ggml_permute(g, blended, 2, 0, 1, 3));
+    }
+
+    ggml_tensor* llul_forward(GGMLRunnerContext* ctx, ggml_tensor* input, LlulLayer kind,
+                              const std::string& layer, const std::function<ggml_tensor*(ggml_tensor*)>& forward) {
+        auto& pass = active;
+        const auto* config = pass.llul;
+        if (!config || !(config->layers & kind))
+            return forward(input);
+        if (kind != LlulOutput && !config->filters.empty()) {
+            const auto label = layer_label(layer, kind);
+            if (label.empty() || std::none_of(config->filters.begin(), config->filters.end(),
+                                               [&](const auto& filter) { return label.find(filter) != std::string::npos; }))
+                return forward(input);
+        }
+        const bool tokens = kind == LlulSelf || kind == LlulCross;
+        const int width = int(tokens ? pass.spatial_w : input->ne[0]);
+        const int height = int(tokens ? pass.spatial_h : input->ne[1]);
+        if (tokens && int64_t(width) * height != input->ne[1])
+            return forward(input);
+        const int factor = config->factor, w = width / factor, h = height / factor;
+        if (w == 0 || h == 0)
+            return forward(input);
+        ++pass.llul_regions;
+        pass.llul_layers |= kind;
+        if (!pass.llul_graph)
+            pass.llul_graph = std::make_shared<LlulGraphData>();
+
+        auto* graph = ctx->ggml_ctx;
+        const auto to_image = [&](ggml_tensor* t) {
+            if (!tokens)
+                return t;
+            const auto batch = t->ne[2], channels = t->ne[0];
+            auto* planar = ggml_cont(graph, ggml_permute(graph, t, 1, 0, 2, 3));
+            return ggml_reshape_4d(graph, planar, width, height, channels, batch);
+        };
+        const auto to_tokens = [&](ggml_tensor* t) {
+            if (!tokens)
+                return t;
+            auto* planar = ggml_reshape_3d(graph, ggml_cont(graph, t), width * height, t->ne[2], t->ne[3]);
+            return ggml_cont(graph, ggml_permute(graph, planar, 1, 0, 2, 3));
+        };
+        const int x = region_origin(width, w, config->x), y = region_origin(height, h, config->y);
+        auto* image = to_image(input);
+        auto* region = ggml_cont(graph, crop(graph, image, x, y, w, h));
+        if (region->type != GGML_TYPE_F32)
+            region = ggml_cast(graph, region, GGML_TYPE_F32);
+        auto* extra = resize(*ctx, region, w * factor, h * factor,
+                             width - w * factor, height - h * factor, config->up, config->up_aa);
+        auto* base = to_image(forward(input));
+        extra = to_image(forward(to_tokens(extra)));
+        auto* reduced = config->down == LlulMean || config->down == LlulMax
+            ? ggml_pool_2d(graph, extra, config->down == LlulMean ? GGML_OP_POOL_AVG : GGML_OP_POOL_MAX,
+                           factor, factor, factor, factor, 0, 0)
+            : resize(*ctx, extra, w, h, 0, 0, config->down, config->down_aa, factor);
+        auto* low = ggml_cont(graph, crop(graph, base, x, y, w, h));
+        if (config->force_float || low->type != GGML_TYPE_F32)
+            low = ggml_cast(graph, low, GGML_TYPE_F32);
+        auto* delta = ggml_sub(graph, reduced, low);
+        ggml_tensor* mixed;
+        if (config->mask) {
+            auto& mask = pass.llul_graph->mask;
+            if (!mask) {
+                const auto& s = config->mask->shape();
+                mask = ggml_new_tensor_4d(graph, GGML_TYPE_F32, s[0], s[1], 1, 1);
+                ctx->set_backend_tensor_data(mask, config->mask->data());
+            }
+            auto* weights = resize(*ctx, mask, w, h, 0, 0, LlulBilinear, true);
+            mixed = ggml_add(graph, low, ggml_mul(graph, delta, ggml_scale(graph, weights, config->weight)));
+        } else if (config->slerp) {
+            mixed = spherical(graph, low, reduced, config->weight);
+        } else {
+            mixed = ggml_add(graph, low, ggml_scale(graph, delta, config->weight));
+        }
+        base = ggml_cont(graph, base);
+        if (mixed->type != base->type)
+            mixed = ggml_cast(graph, mixed, base->type);
+        return to_tokens(ggml_set(graph, base, mixed, base->nb[1], base->nb[2], base->nb[3],
+                                  x * base->nb[0] + y * base->nb[1]));
+    }
+}
