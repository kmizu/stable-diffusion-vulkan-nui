+#pragma once
+
+#include <functional>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "core/tensor.hpp"
+
+struct GGMLRunnerContext;
+struct ggml_tensor;
+
+namespace sd::nui {
+    enum LlulLayer { LlulResblock = 1, LlulTransformer = 2, LlulSelf = 4, LlulCross = 8, LlulOutput = 16 };
+    enum LlulScale { LlulNearest, LlulBilinear, LlulBicubic, LlulMean, LlulMax };
+
+    struct LlulConfig {
+        int layers = 0, factor = 2, start = 5, end = 0;
+        double x = .25, y = .25;
+        float weight = .15f;
+        int up = LlulBilinear, down = LlulBilinear;
+        bool up_aa = false, down_aa = false, slerp = false, force_float = false;
+        std::vector<std::string> filters;
+        std::shared_ptr<const sd::Tensor<float>> mask;
+        bool operator==(const LlulConfig& other) const {
+            return layers == other.layers && factor == other.factor && start == other.start && end == other.end &&
+                   x == other.x && y == other.y && weight == other.weight && up == other.up && down == other.down &&
+                   up_aa == other.up_aa && down_aa == other.down_aa && slerp == other.slerp &&
+                   force_float == other.force_float && filters == other.filters && mask == other.mask;
+        }
+    };
+
+    struct LlulGraphData;
+    ggml_tensor* llul_forward(GGMLRunnerContext* ctx, ggml_tensor* input, LlulLayer kind,
+                              const std::string& layer, const std::function<ggml_tensor*(ggml_tensor*)>& forward);
+}
