+++ b/src/model/common/agent_attention.hpp
@@ -0,0 +1,149 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+#include "core/ggml_runner.h"
+#include "model/common/nui_unet_hooks.hpp"
+
+namespace sd::nui {
+
+    inline const AgentStage* active_agent_stage(const ggml_tensor* x) {
+        const auto* options = active.options;
+        if (!options || !options->agent_timeline || active.depth_factor > options->agent_depth ||
+            int64_t(active.spatial_w) * active.spatial_h != x->ne[1])
+            return nullptr;
+        const auto& stage = options->agent_timeline->step < options->agent_switch
+            ? options->agent_first : options->agent_second;
+        return stage.sx ? &stage : nullptr;
+    }
+
+    inline ggml_tensor* agent_indices(GGMLRunnerContext& ctx, std::vector<int32_t> indices) {
+        auto* tensor = ggml_new_tensor_1d(ctx.ggml_ctx, GGML_TYPE_I32, int64_t(indices.size()));
+        active.agent_indices.push_back(std::move(indices));
+        ctx.set_backend_tensor_data(tensor, active.agent_indices.back().data());
+        return tensor;
+    }
+
+    inline ggml_tensor* agent_fp32_attention(ggml_context* graph, ggml_tensor* q, ggml_tensor* k,
+                                              ggml_tensor* v, int64_t heads, float scale) {
+        const auto width = q->ne[0] / heads;
+        const auto split = [&](ggml_tensor* t) {
+            auto* shaped = ggml_reshape_3d(graph, t, width, heads, t->ne[1]);
+            return ggml_cont(graph, ggml_permute(graph, shaped, 0, 2, 1, 3));
+        };
+        auto* scores = ggml_mul_mat(graph, split(k), split(q));
+        ggml_prec_set_acc(scores, GGML_PREC_F32);
+        auto* values = ggml_cont(graph, ggml_transpose(graph, split(v)));
+        auto* mixed = ggml_mul_mat(graph, values, ggml_soft_max_ext(graph, scores, nullptr, scale, 0.f));
+        ggml_prec_set_acc(mixed, GGML_PREC_F32);
+        return ggml_cont_2d(graph, ggml_permute(graph, mixed, 0, 2, 1, 3), width * heads, q->ne[1]);
+    }
+
+    template<class Attend>
+    ggml_tensor* merge_agent_attention(GGMLRunnerContext* ctx, ggml_tensor* tokens, ggml_tensor* metric,
+                                       const AgentStage& stage, const Attend& attend) {
+        auto* graph = ctx->ggml_ctx;
+        const int w = active.spatial_w, h = active.spatial_h;
+        const int count = int(tokens->ne[1]), batch = int(tokens->ne[2]);
+        const int cols = w / stage.sx, rows = h / stage.sy;
+        if (cols == 0 || rows == 0)
+            throw std::runtime_error("Agent Attention strides exceed the attention grid");
+        const int dest_count = cols * rows;
+        const int source_count = count - dest_count;
+        if (!source_count)
+            return attend(tokens, nullptr);
+        const int remove = std::min(source_count, int(count * stage.ratio));
+        const int remove_agents = std::min(source_count, int(count * stage.agents));
+        if (!remove)
+            throw std::runtime_error("Agent Attention ratio merges no tokens at this resolution");
+        const bool use_agents = 2 * (count - remove_agents) < count - remove;
+        ++active.agent_layers;
+        active.agent_attention_layers += use_agents;
+
+        std::vector<int32_t> dest, source;
+        std::vector<bool> selected(count, false);
+        std::uniform_int_distribution<int> choose(0, stage.sx * stage.sy - 1);
+        auto& rng = active.options->agent_timeline->random;
+        for (int y = 0; y < rows; ++y) {
+            for (int x = 0; x < cols; ++x) {
+                const int pick = batch % 2 == 0 ? choose(rng) : 0;
+                const int index = (y * stage.sy + pick / stage.sx) * w + x * stage.sx + pick % stage.sx;
+                selected[index] = true;
+                dest.push_back(index);
+            }
+        }
+        for (int i = 0; i < count; ++i)
+            if (!selected[i])
+                source.push_back(i);
+        auto* dest_ids = agent_indices(*ctx, std::move(dest));
+        auto* source_ids = agent_indices(*ctx, std::move(source));
+        auto* dest_range = ggml_arange(graph, 0, float(dest_count), 1);
+        dest_range = ggml_reshape_2d(graph, dest_range, 1, dest_count);
+
+        const auto slice_index = [&](ggml_tensor* t, int first, int length) {
+            return ggml_view_1d(graph, t, length, first * t->nb[0]);
+        };
+        const auto gather_index = [&](ggml_tensor* t, ggml_tensor* ids) {
+            t = ggml_reshape_2d(graph, t, 1, ggml_nelements(t));
+            return ggml_reshape_1d(graph, ggml_get_rows(graph, t, ids), ggml_nelements(ids));
+        };
+        const auto branch = [&](ggml_tensor* t, int b) {
+            return ggml_cont(graph, ggml_view_2d(graph, t, t->ne[0], count, t->nb[1], t->nb[2] * b));
+        };
+        ggml_tensor* combined = nullptr;
+        for (int b = 0; b < batch; ++b) {
+            auto* input = branch(tokens, b);
+            // RMS-normalization multiplies all cosine scores by the same channel count.
+            auto* unit = ggml_rms_norm(graph, branch(metric, b), 1e-12f);
+            auto* similarity = ggml_mul_mat(graph, ggml_get_rows(graph, unit, dest_ids),
+                                            ggml_get_rows(graph, unit, source_ids));
+            auto* nearest = ggml_argmax(graph, similarity);
+            auto* best = ggml_pool_2d(graph, similarity, GGML_OP_POOL_MAX, dest_count, 1, dest_count, 1, 0, 0);
+            auto* order = ggml_argsort(graph, ggml_reshape_1d(graph, best, source_count), GGML_SORT_ORDER_DESC);
+            auto* destinations = ggml_get_rows(graph, input, dest_ids);
+            const auto merge = [&](int n, ggml_tensor*& kept_ids, ggml_tensor*& merged_ids, ggml_tensor*& target) {
+                const int keep = source_count - n;
+                auto* merged_order = slice_index(order, 0, n);
+                merged_ids = gather_index(source_ids, merged_order);
+                target = gather_index(nearest, merged_order);
+                auto* target_values = ggml_cast(graph, target, GGML_TYPE_F32);
+                auto* assignments = ggml_repeat_4d(graph, target_values, n, dest_count, 1, 1);
+                auto* dest_grid = ggml_repeat_4d(graph, dest_range, n, dest_count, 1, 1);
+                auto* distance = ggml_abs(graph, ggml_sub(graph, assignments, dest_grid));
+                auto* one_hot = ggml_step(graph, ggml_scale_bias(graph, distance, -1.f, 0.5f));
+                auto* selected = ggml_get_rows(graph, input, merged_ids);
+                auto* sums = ggml_mul_mat(graph, one_hot, ggml_cont(graph, ggml_transpose(graph, selected)));
+                auto* counts = ggml_scale_bias(graph, ggml_sum_rows(graph, one_hot), 1.f, 1.f);
+                auto* mean = ggml_div(graph, ggml_add(graph, destinations, ggml_cont(graph, ggml_transpose(graph, sums))), counts);
+                if (!keep)
+                    return mean;
+                kept_ids = gather_index(source_ids, slice_index(order, n, keep));
+                return ggml_concat(graph, ggml_get_rows(graph, input, kept_ids), mean, 1);
+            };
+
+            ggml_tensor *kept = nullptr, *removed = nullptr, *target = nullptr;
+            auto* merged = merge(remove, kept, removed, target);
+            ggml_tensor* agents = nullptr;
+            if (use_agents) {
+                ggml_tensor *unused_kept = nullptr, *unused_removed = nullptr, *unused_target = nullptr;
+                agents = merge(remove_agents, unused_kept, unused_removed, unused_target);
+            }
+            auto* result = attend(merged, agents);
+            const int keep = source_count - remove;
+            auto* target_out = ggml_view_2d(graph, result, result->ne[0], dest_count, result->nb[1], result->nb[1] * keep);
+            auto* removed_out = ggml_get_rows(graph, target_out, target);
+            auto* restored = ggml_concat(graph, result, removed_out, 1);
+            const auto append_indices = [&](ggml_tensor* left, ggml_tensor* right) {
+                return ggml_cast(graph, ggml_concat(graph, ggml_cast(graph, left, GGML_TYPE_F32),
+                                                    ggml_cast(graph, right, GGML_TYPE_F32), 0), GGML_TYPE_I32);
+            };
+            auto* ordered_ids = append_indices(dest_ids, removed);
+            if (kept)
+                ordered_ids = append_indices(kept, ordered_ids);
+            auto* output = ggml_set_rows(graph, ggml_scale(graph, input, 0.f), restored, ordered_ids);
+            combined = combined ? ggml_concat(graph, combined, output, 2) : output;
+        }
+        return combined;
+    }
+}
