@@ -0,0 +1,123 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <set>
+
+#include "model/common/nui_seg.hpp"
+
+namespace sd::nui {
+    struct ScfgCapture {
+        const ScfgConfig& config;
+        std::set<int> depths;
+        int64_t width, height;
+        ggml_tensor* self = nullptr;
+        ggml_tensor* sum = nullptr;
+        int layers = 0;
+
+        ScfgCapture(const ScfgConfig& config, int64_t latent_width, int64_t latent_height)
+            : config(config), width(latent_width / config.r), height(latent_height / config.r) {
+            if (width < 2 || height < 2)
+                throw std::runtime_error("S-CFG R leaves fewer than two pixels per side in the mask");
+        }
+    };
+
+    inline ggml_tensor* scfg_head_mean(ggml_context* graph, ggml_tensor* projection, int heads) {
+        const auto dim = projection->ne[0] / heads;
+        const auto tokens = projection->ne[1];
+        auto* first = ggml_view_2d(graph, projection, projection->ne[0], tokens, projection->nb[1], 0);
+        auto* rows = ggml_reshape_3d(graph, ggml_cont(graph, ggml_cast(graph, first, GGML_TYPE_F32)), dim, heads, tokens);
+        auto* per_head = ggml_cont(graph, ggml_permute(graph, rows, 1, 0, 2, 3));
+        return ggml_reshape_2d(graph, ggml_mean(graph, per_head), dim, tokens);
+    }
+
+    inline ggml_tensor* scfg_normalize(ggml_context* graph, ggml_tensor* rows, bool epsilon) {
+        auto* mean = ggml_mean(graph, rows);
+        if (epsilon)
+            mean = ggml_scale_bias(graph, mean, 1.f, std::numeric_limits<float>::epsilon());
+        return ggml_div(graph, rows, ggml_repeat(graph, mean, rows));
+    }
+
+    inline ggml_tensor* scfg_propagate(ggml_context* graph, ggml_tensor* self_query, ggml_tensor* dense,
+                                      ggml_tensor* tokens, int64_t block_size = 512) {
+        auto* values = ggml_cont(graph, ggml_transpose(graph, tokens));
+        if (dense)
+            return ggml_mul_mat(graph, values, dense);
+        ggml_tensor* output = nullptr;
+        for (int64_t first = 0; first < self_query->ne[1]; first += block_size) {
+            const auto count = std::min(block_size, self_query->ne[1] - first);
+            auto* rows = ggml_view_2d(graph, self_query, self_query->ne[0], count, self_query->nb[1],
+                                      first * self_query->nb[1]);
+            // Normalize against all keys even when computing only a block of query rows.
+            auto* attention = ggml_soft_max(graph, ggml_mul_mat(graph, self_query, rows));
+            auto* product = ggml_mul_mat(graph, values, attention);
+            output = output ? ggml_concat(graph, output, product, 1) : product;
+        }
+        return output;
+    }
+
+    inline void scfg_capture(GGMLRunnerContext* ctx, ggml_tensor* q, ggml_tensor* k, int heads, bool self) {
+        auto* state = active.scfg;
+        if (!state || !state->depths.count(active.depth_factor))
+            return;
+        auto* graph = ctx->ggml_ctx;
+        auto* query = scfg_head_mean(graph, q, heads);
+        if (self) {
+            state->self = query;
+            return;
+        }
+        if (!state->self || state->self->ne[1] != q->ne[1])
+            throw std::runtime_error("S-CFG could not pair self-attention with cross-attention");
+        auto* keys = scfg_head_mean(graph, k, heads);
+        auto* cross = ggml_soft_max(graph, ggml_mul_mat(graph, keys, query));
+        auto* dense = state->self->ne[1] <= 2048
+            ? ggml_soft_max(graph, ggml_mul_mat(graph, state->self, state->self))
+            : nullptr;
+        // (A + A² + … + A^R)·C / R without constructing dense powers of A.
+        ggml_tensor* power = cross;
+        ggml_tensor* total = nullptr;
+        for (int i = 0; i < state->config.r; ++i) {
+            power = scfg_propagate(graph, state->self, dense, power);
+            total = total ? ggml_add(graph, total, power) : power;
+        }
+        state->self = nullptr;
+        if (state->config.r > 1)
+            total = ggml_scale(graph, total, 1.f / state->config.r);
+        const auto tokens = total->ne[0];
+        const auto space = total->ne[1];
+        const auto rows = int64_t(std::nearbyint(std::sqrt(space * (double(state->config.height) / state->config.width))));
+        if (rows < 1 || space % rows != 0 || tokens < 2)
+            throw std::runtime_error("S-CFG cannot lay out the attention queries or prompt tokens");
+        auto* grid = ggml_reshape_3d(graph, total, tokens, space / rows, rows);
+        auto* planar = ggml_cont(graph, ggml_permute(graph, grid, 2, 0, 1, 3));
+        auto* resized = ggml_interpolate(graph, planar, state->width, state->height, tokens, 1, GGML_SCALE_MODE_BILINEAR);
+        const float edge = std::exp(-1.f);
+        const float center = 1.f / (1.f + 2.f * edge);
+        const std::vector<float> kernel{edge * center, center, edge * center};
+        auto* horizontal = seg_axis(ctx, resized, state->width, kernel);
+        auto* vertical_input = ggml_cont(graph, ggml_transpose(graph, horizontal));
+        auto* smoothed = ggml_cont(graph, ggml_transpose(graph, seg_axis(ctx, vertical_input, state->height, kernel)));
+        const auto pixels = state->width * state->height;
+        auto* maps = ggml_reshape_2d(graph, smoothed, pixels, tokens);
+        auto* foreground_tokens = ggml_view_2d(graph, maps, pixels, tokens - 1, maps->nb[1], maps->nb[1]);
+        auto* foreground = ggml_reshape_2d(graph, ggml_sum_rows(graph,
+            ggml_cont(graph, ggml_transpose(graph, foreground_tokens))), pixels, 1);
+        auto* background = ggml_view_2d(graph, maps, pixels, 1, maps->nb[1], 0);
+        auto* grouped = scfg_normalize(graph, ggml_concat(graph, background, foreground, 1), false);
+        auto* normalized = ggml_concat(graph, scfg_normalize(graph, maps, true), grouped, 1);
+        state->sum = state->sum ? ggml_add(graph, state->sum, normalized) : normalized;
+        ++state->layers;
+    }
+
+    inline ggml_tensor* scfg_pack(ggml_context* graph, ggml_tensor* output) {
+        const auto* state = active.scfg;
+        if (!state)
+            return output;
+        if (!state->sum || state->self)
+            throw std::runtime_error("S-CFG found incomplete attention maps");
+        auto* grid = ggml_reshape_3d(graph, state->sum, state->width, state->height, state->sum->ne[1]);
+        auto* packed = ggml_pad(graph, grid, output->ne[0] - state->width, output->ne[1] - state->height, 0, 0);
+        return ggml_concat(graph, output, packed, 2);
+    }
+}
