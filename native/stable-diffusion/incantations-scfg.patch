+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+#include <utility>
+#include <vector>
+
+#include "core/tensor.hpp"
+#include "model/common/nui_unet_hooks.hpp"
+
+namespace sd::nui {
+    inline std::pair<float, float> scfg_apply_rate(Tensor<float>& delta, const Tensor<float>& maps,
+                                                  float cfg, const ScfgConfig& config) {
+        const auto& shape = delta.shape();
+        const int64_t w = shape[0], h = shape[1], channels = shape[2], plane = w * h;
+        const int64_t sw = maps.shape()[0], sh = maps.shape()[1], tokens = maps.shape()[2] - 2, small = sw * sh;
+        if (h == sh * config.r && w != sw * config.r)
+            throw std::runtime_error("S-CFG latent width must divide by R when the height does");
+        std::vector<float> maximum(small, -std::numeric_limits<float>::infinity());
+        for (int64_t t = 0; t < tokens; ++t)
+            for (int64_t i = 0; i < small; ++i)
+                maximum[i] = std::max(maximum[i], maps.data()[t * small + i]);
+
+        auto mask = [&](int64_t token, int64_t place) {
+            if (token == tokens)
+                return float(maps.data()[(tokens + 1) * small + place] > maps.data()[tokens * small + place]);
+            return float(maps.data()[token * small + place] == maximum[place]);
+        };
+        auto mask_value = [&](int64_t token, int64_t x, int64_t y) {
+            if (sw * config.r == w && sh * config.r == h)
+                return mask(token, (y / config.r) * sw + x / config.r);
+            const auto px = std::clamp((x + 0.5) * double(sw * config.r) / w - 0.5, 0.0, double(sw * config.r - 1));
+            const auto py = std::clamp((y + 0.5) * double(sh * config.r) / h - 0.5, 0.0, double(sh * config.r - 1));
+            const auto ax = int64_t(px), ay = int64_t(py);
+            const auto bx = std::min(ax + 1, sw * config.r - 1), by = std::min(ay + 1, sh * config.r - 1);
+            const auto fx = float(px - ax), fy = float(py - ay);
+            auto read = [&](int64_t ix, int64_t iy) { return mask(token, (iy / config.r) * sw + ix / config.r); };
+            const float top = read(ax, ay) * (1.f - fx) + read(bx, ay) * fx;
+            const float bottom = read(ax, by) * (1.f - fx) + read(bx, by) * fx;
+            return top * (1.f - fy) + bottom * fy;
+        };
+        const float eps = std::numeric_limits<float>::epsilon();
+        std::vector<float> norm(plane), rate(plane, 0.f);
+        for (int64_t i = 0; i < plane; ++i) {
+            float squared = 0.f;
+            for (int64_t c = 0; c < channels; ++c) {
+                const float value = delta.data()[c * plane + i];
+                squared += value * value;
+            }
+            norm[i] = std::sqrt(squared);
+        }
+        auto average = [&](int64_t token) {
+            float total = 0.f, weight = 0.f;
+            for (int64_t i = 0; i < plane; ++i) {
+                const float v = mask_value(token, i % w, i / w);
+                weight += v;
+                total += norm[i] * v;
+            }
+            return std::pair{total / (weight + eps), weight > 0.f};
+        };
+        const auto foreground = average(tokens).first;
+        for (int64_t token = 0; token < tokens; ++token) {
+            const auto [mean, present] = average(token);
+            if (present) {
+                const float gain = foreground / (mean + eps);
+                for (int64_t i = 0; i < plane; ++i)
+                    rate[i] += gain * mask_value(token, i % w, i / w);
+            }
+        }
+        const auto cap = config.clamp > 0.f ? config.clamp / cfg : std::numeric_limits<float>::infinity();
+        for (float& value : rate)
+            value = std::min(cap, std::min(config.max_rate, std::max(config.min_rate, value * config.scale)));
+        const auto [low, high] = std::minmax_element(rate.begin(), rate.end());
+        const float edge = std::exp(-1.f);
+        const float center = 1.f / (1.f + 2.f * edge);
+        const float kernel[] = {edge * center, center, edge * center};
+        auto reflect = [](int64_t index, int64_t size) {
+            return index < 0 ? -index : (index >= size ? 2 * size - 2 - index : index);
+        };
+        for (int64_t y = 0; y < h; ++y) {
+            for (int64_t x = 0; x < w; ++x) {
+                float gain = 0.f;
+                for (int dy = -1; dy <= 1; ++dy)
+                    for (int dx = -1; dx <= 1; ++dx)
+                        gain += kernel[dy + 1] * kernel[dx + 1] * rate[reflect(y + dy, h) * w + reflect(x + dx, w)];
+                for (int64_t c = 0; c < channels; ++c)
+                    delta.data()[c * plane + y * w + x] *= gain;
+            }
+        }
+        return {*low, *high};
+    }
+}
