+    Value dynthresh_scale(Values& args, RunState&) {
+        const auto predict = object<ops::Predictor>(args, "predict");
+        const auto& denoiser = ops::scaling_parameterization(*predict);
+        const auto timestep = denoiser.timestep(float(get_number(args, "sigma")));
+        const double fraction = 1.0 - std::clamp(double(timestep), 0.0, 999.0) / 999.0;
+        const double schedule = get_number(args, "schedule");
+        const double cycle = std::fmod(fraction * schedule, 1.0);
+        const auto mode = get_string(args, "mode");
+        double weight;
+        if (mode == "Linear Down") weight = 1.0 - fraction;
+        else if (mode == "Half Cosine Down") weight = std::cos(fraction);
+        else if (mode == "Cosine Down") weight = std::cos(fraction * 1.5707);
+        else if (mode == "Linear Up") weight = fraction;
+        else if (mode == "Half Cosine Up") weight = 1.0 - std::cos(fraction);
+        else if (mode == "Cosine Up") weight = 1.0 - std::cos(fraction * 1.5707);
+        else if (mode == "Power Up") weight = std::pow(fraction, schedule);
+        else if (mode == "Power Down") weight = 1.0 - std::pow(fraction, schedule);
+        else if (mode == "Linear Repeating") weight = 2.0 * std::abs(cycle - 0.5);
+        else if (mode == "Cosine Repeating") weight = 0.5 + 0.5 * std::cos(fraction * 6.28318 * schedule);
+        else if (mode == "Sawtooth") weight = cycle;
+        else throw std::runtime_error("unknown Dynamic Thresholding schedule");
+        const auto minimum = get_number(args, "minimum");
+        return Value::literal(minimum + weight * (get_number(args, "target") - minimum));
+    }
+
