+    std::array<float, width> slerp(const std::array<float, width>& a,
+                                    const std::array<float, width>& b, float fraction) {
+        double dot = 0;
+        for (size_t i = 0; i < a.size(); ++i)
+            dot += static_cast<double>(a[i]) * b[i];
+        const double angle = std::acos(std::clamp(dot, -1.0, 1.0));
+        const double sine = std::sin(angle);
+        double wa = 1.0 - fraction, wb = fraction;
+        if (std::abs(sine) >= 1e-6) {
+            wa = std::sin(wa * angle) / sine;
+            wb = std::sin(wb * angle) / sine;
+        }
+        std::array<float, width> result;
+        double square = 0;
+        for (size_t i = 0; i < a.size(); ++i) {
+            result[i] = static_cast<float>(wa * a[i] + wb * b[i]);
+            square += static_cast<double>(result[i]) * result[i];
+        }
+        if (!(square > 0) || !std::isfinite(square))
+            throw std::runtime_error("Aesthetic slerp produced an invalid target");
+        const double norm = std::sqrt(square);
+        for (float& value : result)
+            value = static_cast<float>(value / norm);
+        return result;
+    }
