+#include "model/common/nui_unet_hooks.hpp"
+#include "ggml.h"
+#include <algorithm>
+#include <cmath>
+#include <random>
+#include <vector>
+
+namespace sd::nui {
+    static int tile_divisor(int side, int minimum, int options, std::mt19937& rng) {
+        std::vector<int> sizes;
+        for (int i = std::min(side, minimum); i <= side && int(sizes.size()) < options; ++i)
+            if (side % i == 0) sizes.push_back(i);
+        return sizes[std::uniform_int_distribution<int>(0, int(sizes.size()) - 1)(rng)];
+    }
+
+    std::pair<int,int> tile_shape() {
+        const auto& pass = active;
+        const auto* opt = pass.options;
+        if (!opt || !opt->tile_size) return {0,0};
+        // Model construction and execution both build the graph. Drawing from the
+        // step and model-layer index gives them the same layout on each branch.
+        std::seed_seq seed{opt->tile_seed, pass.step, active.layer_index++};
+        std::mt19937 rng(seed);
+        for (int depth = 0; depth <= opt->max_depth; ++depth) {
+            const int scale = 1 << depth;
+            if (pass.width != pass.spatial_w * scale || pass.height != pass.spatial_h * scale) continue;
+            const int minimum = std::max(32, opt->tile_size) / 8 * (opt->scale_depth ? scale : 1);
+            const int th = tile_divisor(pass.spatial_h, minimum, opt->swap_size, rng);
+            const int tw = tile_divisor(pass.spatial_w, minimum, opt->swap_size, rng);
+            if (tw < pass.spatial_w || th < pass.spatial_h) return {tw,th};
+            break;
+        }
+        return {0,0};
+    }
+
+    ggml_tensor* split_tiles(ggml_context* ctx, ggml_tensor* x, int tw, int th, bool restore) {
+        const int nw = active.spatial_w / tw, nh = active.spatial_h / th;
+        const auto c = x->ne[0], batch = restore ? x->ne[2] / (nw * nh) : x->ne[2];
+        x = ggml_reshape_4d(ctx, x, c*tw, restore ? th : nw, restore ? nw : th, nh*batch);
+        x = ggml_cont(ctx, ggml_permute(ctx, x, 0, 2, 1, 3));
+        return ggml_reshape_3d(ctx, x, c, restore ? active.spatial_w*active.spatial_h : tw*th,
+                               restore ? batch : batch*nw*nh);
+    }
+
+    // PyTorch nearest-exact and adaptive-area interpolation, expressed as separable
+    // projections. Spatial axes are small in U-Net feature maps.
+    static ggml_tensor* project_axis(ggml_context* ctx, ggml_tensor* x, int output, bool area) {
+        const int64_t input = x->ne[0];
+        if (input == output) return x;
+        const float ratio = float(input)/output;
+        auto pos = ggml_arange(ctx,0,float(output),1);
+        auto lo = area ? ggml_floor(ctx,ggml_scale(ctx,pos,ratio)) :
+                         ggml_floor(ctx,ggml_scale_bias(ctx,pos,ratio,0.5f*ratio));
+        auto hi = area ? ggml_ceil(ctx,ggml_scale_bias(ctx,pos,ratio,ratio)) : ggml_scale_bias(ctx,lo,1.f,1.f);
+        lo = ggml_reshape_2d(ctx,lo,1,output);
+        hi = ggml_reshape_2d(ctx,hi,1,output);
+        auto loc = ggml_repeat_4d(ctx,ggml_arange(ctx,0,float(input),1),input,output,1,1);
+        auto above = ggml_step(ctx,ggml_scale_bias(ctx,ggml_sub(ctx,loc,lo),1.f,0.5f));
+        auto below = ggml_step(ctx,ggml_scale_bias(ctx,ggml_sub(ctx,loc,hi),-1.f,-0.5f));
+        auto weights = ggml_div(ctx,ggml_mul(ctx,above,below),ggml_sub(ctx,hi,lo));
+        auto flat = ggml_reshape_2d(ctx,x,input,x->ne[1]*x->ne[2]*x->ne[3]);
+        return ggml_reshape_4d(ctx,ggml_mul_mat(ctx,weights,flat),output,x->ne[1],x->ne[2],x->ne[3]);
+    }
+
+    ggml_tensor* resize_features(ggml_context* ctx, ggml_tensor* x, int w, int h, int mode) {
+        if (x->ne[0] == w && x->ne[1] == h) return x;
+        if (mode == GGML_SCALE_MODE_BILINEAR || mode == GGML_SCALE_MODE_BICUBIC)
+            return ggml_interpolate(ctx,x,w,h,x->ne[2],x->ne[3],mode);
+        x = project_axis(ctx,x,w,mode == 3);
+        x = ggml_cont(ctx,ggml_permute(ctx,x,1,0,2,3));
+        x = project_axis(ctx,x,h,mode == 3);
+        return ggml_cont(ctx,ggml_permute(ctx,x,1,0,2,3));
+    }
+
+    ggml_tensor* subsample_tokens(ggml_context* ctx, ggml_tensor* x) {
+        const auto* opt = active.options;
+        if (!opt || active.evaluation <= 0 || active.evaluation > opt->token_evaluations) return x;
+        const float factor = active.depth_factor == opt->token_first_depth ? opt->token_factor :
+                             active.depth_factor == 2*opt->token_first_depth ? opt->token_factor2 : 1.f;
+        if (factor <= 1.f) return x;
+        int w = active.spatial_w, h = active.spatial_h;
+        const int out_w = std::max(1,int(w/factor)), out_h = std::max(1,int(h/factor));
+        auto ix = ggml_floor(ctx,ggml_scale_bias(ctx,ggml_arange(ctx,0,float(out_w),1),float(w)/out_w,0.5f*w/out_w));
+        auto iy = ggml_floor(ctx,ggml_scale_bias(ctx,ggml_arange(ctx,0,float(out_h),1),float(h)/out_h,0.5f*h/out_h));
+        auto index = ggml_add(ctx,ggml_repeat_4d(ctx,ix,out_w,out_h,1,1),ggml_reshape_2d(ctx,ggml_scale(ctx,iy,float(w)),1,out_h));
+        index = ggml_reshape_2d(ctx,ggml_cast(ctx,index,GGML_TYPE_I32),out_w*out_h,1);
+        return ggml_get_rows(ctx,x,ggml_repeat_4d(ctx,index,out_w*out_h,x->ne[2],1,1));
+    }
+
+    bool shrink_enabled() {
+        const auto* opt = active.options;
+        return opt && opt->shrink_block && opt->shrink_factor != 1.f &&
+               active.timestep >= opt->shrink_t_lo && active.timestep <= opt->shrink_t_hi;
+    }
+
+    ggml_tensor* deep_shrink(ggml_context* ctx,ggml_tensor* x,int block) {
+        if (!shrink_enabled() || active.options->shrink_block != block) return x;
+        const auto& opt = *active.options;
+        const int w = std::max(1,int(std::nearbyint(x->ne[0]/double(opt.shrink_factor))));
+        const int h = std::max(1,int(std::nearbyint(x->ne[1]/double(opt.shrink_factor))));
+        return resize_features(ctx,x,w,h,opt.shrink_down_mode);
+    }
+
+    // FreeU scales the center 2x2 fftshift window. Reconstruct just those four
+    // real Fourier terms instead of transforming every frequency and discarding it.
+    static ggml_tensor* fourier_filter(ggml_context* ctx, ggml_tensor* skip, float scale) {
+        const auto w = skip->ne[0], h = skip->ne[1], n = w*h;
+        const float tau = 6.283185307179586f;
+        auto x = ggml_scale(ctx, ggml_arange(ctx, 0, float(w), 1), tau / w);
+        auto y = ggml_scale(ctx, ggml_arange(ctx, 0, float(h), 1), tau / h);
+        y = ggml_reshape_2d(ctx, y, 1, h);
+        x = ggml_repeat_4d(ctx, x, w, h, 1, 1);
+        y = ggml_repeat_4d(ctx, y, w, h, 1, 1);
+        auto basis = ggml_reshape_2d(ctx, ggml_fill(ctx, x, 1.f), n, 1);
+        auto append = [&](ggml_tensor* phase) {
+            basis = ggml_concat(ctx, basis, ggml_reshape_2d(ctx, ggml_cos(ctx,phase), n, 1), 1);
+            basis = ggml_concat(ctx, basis, ggml_reshape_2d(ctx, ggml_sin(ctx,phase), n, 1), 1);
+        };
+        if (w > 1) append(x);
+        if (h > 1) append(y);
+        if (w > 1 && h > 1) append(ggml_add(ctx,x,y));
+        auto original = ggml_reshape_2d(ctx, skip, n, skip->ne[2]*skip->ne[3]);
+        auto coeff = ggml_mul_mat(ctx, basis, original);
+        auto low = ggml_mul_mat(ctx, ggml_cont(ctx,ggml_transpose(ctx,basis)), coeff);
+        return ggml_add(ctx, skip, ggml_reshape(ctx,ggml_scale(ctx,low,(scale-1.f)/n),skip));
+    }
+
+    void apply_freeu(ggml_context* ctx, ggml_tensor*& h, ggml_tensor*& skip, int stage) {
+        if (!active.options || stage > 1) return;
+        const float b = active.options->backbone[stage], s = active.options->skip[stage];
+        if (b != 1.f) {
+            const auto half = h->ne[2] / 2;
+            auto half_view = [&](int64_t start, int64_t count) {
+                return ggml_view_4d(ctx,h,h->ne[0],h->ne[1],count,h->ne[3],h->nb[1],h->nb[2],h->nb[3],start*h->nb[2]);
+            };
+            h = ggml_concat(ctx,ggml_scale(ctx,half_view(0,half),b),half_view(half,h->ne[2]-half),2);
+        }
+        if (s != 1.f) skip = fourier_filter(ctx,skip,s);
+    }
+}
