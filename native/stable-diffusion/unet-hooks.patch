+        }
+        if (pass.options && (pass.options->pag_regions & pass.region)) {
+            auto value = std::dynamic_pointer_cast<Linear>(blocks["to_v"])->forward(ctx,x);
+            return std::dynamic_pointer_cast<Linear>(blocks["to_out.0"])->forward(ctx,value);
+        }
+        const auto [tw,th] = sd::nui::tile_shape();
+        if (!tw || x->ne[1] != pass.spatial_w * pass.spatial_h) return forward(ctx,x,sd::nui::subsample_tokens(ctx->ggml_ctx,x));
+        x = sd::nui::split_tiles(ctx->ggml_ctx,x,tw,th,false);
+        x = forward(ctx,x,x);
+        return sd::nui::split_tiles(ctx->ggml_ctx,x,tw,th,true);
+    }
