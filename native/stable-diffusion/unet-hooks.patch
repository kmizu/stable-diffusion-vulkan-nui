+            };
+            auto scores = ggml_mul_mat(ctx->ggml_ctx,projection("to_k"),projection("to_q"));
+            auto probabilities = ggml_soft_max(ctx->ggml_ctx,ggml_scale(ctx->ggml_ctx,scores,1.f/std::sqrt(float(d_head))));
