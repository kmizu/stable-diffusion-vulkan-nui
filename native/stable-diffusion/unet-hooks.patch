+#pragma once
+#include <cstdint>
+#include <utility>
+struct ggml_tensor;
+struct ggml_context;
+
+namespace sd::nui {
+    struct UNetOptions {
+        float backbone[2] = {1.f, 1.f};
+        float skip[2] = {1.f, 1.f};
+        int tile_size = 0, swap_size = 1, max_depth = 0;
+        bool scale_depth = false;
+        int pag_regions = 0;
+        bool sag_capture = false;
+        float token_factor = 1.f, token_factor2 = 1.f;
+        int token_first_depth = 1, token_evaluations = 0;
+        int shrink_block = 0, shrink_down_mode = 2, shrink_up_mode = 2;
+        float shrink_factor = 1.f, shrink_t_lo = 0.f, shrink_t_hi = 999.f;
+        bool shrink_after_skip = true;
+        uint32_t tile_seed = 0;
+    };
+
+    struct UNetPass {
+        const UNetOptions* options = nullptr;
+        int width = 0, height = 0, region = 0, spatial_w = 0, spatial_h = 0;
+        uint32_t step = 0, layer_index = 0;
+        ggml_tensor* attention_mask = nullptr;
+        float timestep = 0.f;
+        int evaluation = 0, depth_factor = 1;
+    };
+    inline thread_local UNetPass active;
+    struct UNetPassScope {
+        UNetPass previous = active;
+        UNetPassScope(const UNetOptions& options, int w, int h, uint32_t step) {
+            active = {&options, w, h, 0, 0, 0, step, 0};
+        }
+        ~UNetPassScope() { active = previous; }
+    };
+    std::pair<int,int> tile_shape();
+    ggml_tensor* split_tiles(ggml_context*, ggml_tensor*, int tw, int th, bool restore);
+    ggml_tensor* resize_features(ggml_context*, ggml_tensor*, int w, int h, int mode);
+    ggml_tensor* subsample_tokens(ggml_context*, ggml_tensor*);
+    bool shrink_enabled();
+    ggml_tensor* deep_shrink(ggml_context*,ggml_tensor*,int block);
+    void apply_freeu(ggml_context*, ggml_tensor*& backbone, ggml_tensor*& skip, int stage);
+}
