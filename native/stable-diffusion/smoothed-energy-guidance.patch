--- /dev/null
+++ b/src/model/common/nui_seg.hpp
@@ -0,0 +1,77 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <stdexcept>
+
+#include "core/ggml_runner.h"
+#include "model/common/nui_unet_hooks.hpp"
+
+namespace sd::nui {
+    inline ggml_tensor* seg_axis(GGMLRunnerContext* ctx, ggml_tensor* input,
+                                 int64_t length, const std::vector<float>& kernel) {
+        const auto radius = int64_t(kernel.size() / 2);
+        auto* weights = ggml_new_tensor_2d(ctx->ggml_ctx, GGML_TYPE_F32, length, length);
+        auto& matrix = active.seg_weights.emplace_back(length * length, 0.f);
+        for (int64_t output = 0; output < length; ++output) {
+            for (int64_t offset = -radius; offset <= radius; ++offset) {
+                const auto source = output + offset;
+                const auto reflected = source < 0 ? -source : (source >= length ? 2 * length - 2 - source : source);
+                matrix[output * length + reflected] += kernel[offset + radius];
+            }
+        }
+        ctx->bind_backend_tensor_data(weights, matrix.data());
+        return ggml_mul_mat(ctx->ggml_ctx, weights, input);
+    }
+
+    inline ggml_tensor* smooth_energy_query(GGMLRunnerContext* ctx, ggml_tensor* query) {
+        const auto* options = active.options;
+        // The source counts the first two sampling evaluations as step zero.
+        const auto step = active.step > 1 ? int(active.step - 2) : 0;
+        if (!options || options->seg_blur == 0.0 || active.region != 256 ||
+            step < options->seg_start || step > options->seg_end)
+            return query;
+
+        auto* graph = ctx->ggml_ctx;
+        const auto channels = query->ne[0];
+        const auto tokens = query->ne[1];
+        const auto batch = query->ne[2];
+        const auto rows = int64_t(std::sqrt(tokens * (double(options->seg_height) / options->seg_width)));
+        if (rows <= 0 || tokens % rows != 0)
+            throw std::runtime_error("SEG cannot lay out the middle self-attention tokens");
+        if (options->seg_blur > 10.5) {
+            auto* spatial = ggml_cont(graph, ggml_transpose(graph, query));
+            auto* mean = ggml_repeat(graph, ggml_mean(graph, spatial), spatial);
+            return ggml_cont(graph, ggml_transpose(graph, mean));
+        }
+
+        const auto cols = tokens / rows;
+        const auto sigma = std::exp2(options->seg_blur);
+        const auto span = std::min(int64_t(std::ceil(6 * sigma)), cols);
+        const auto size = span + 1 - span % 2;
+        if (size == 1)
+            return query;
+        const auto radius = size / 2;
+        if (radius >= rows || radius >= cols)
+            throw std::runtime_error("SEG Gaussian reflection padding exceeds the middle feature dimensions");
+
+        std::vector<float> kernel(size);
+        double total = 0.0;
+        for (int64_t j = -radius; j <= radius; ++j) {
+            const auto scaled = j / sigma;
+            const auto weight = std::exp(-0.5 * scaled * scaled);
+            kernel[j + radius] = float(weight);
+            total += weight;
+        }
+        for (auto& value : kernel)
+            value = float(value / total);
+
+        auto* grid = ggml_reshape_4d(graph, query, channels, cols, rows, batch);
+        auto* width_first = ggml_cont(graph, ggml_permute(graph, grid, 1, 0, 2, 3));
+        auto* horizontal = seg_axis(ctx, width_first, cols, kernel);
+        auto* height_first = ggml_cont(graph, ggml_permute(graph, horizontal, 2, 1, 0, 3));
+        auto* vertical = seg_axis(ctx, height_first, rows, kernel);
+        auto* restored = ggml_cont(graph, ggml_permute(graph, vertical, 2, 0, 1, 3));
+        return ggml_reshape_3d(graph, restored, channels, tokens, batch);
+    }
+}
