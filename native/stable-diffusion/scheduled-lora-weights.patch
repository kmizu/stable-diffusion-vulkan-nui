+    LoraExecution::RuntimeWeights LoraExecution::override_weights(const std::vector<float>& weights) {
+        if (!adapter_ || weights.size() != models_.size())
+            throw std::runtime_error("predictor LoRA weights must match its runtime adapter bindings");
+        RuntimeWeights result;
+        std::vector<std::shared_ptr<LoraModel>> active;
+        result.previous.reserve(weights.size());
+        active.reserve(weights.size());
+        for (size_t i = 0; i < weights.size(); ++i) {
+            result.previous.push_back(models_[i]->multiplier);
+            if (weights[i] != 0.f)
+                active.push_back(models_[i]);
+        }
+        if (!active.empty())
+            result.adapter = std::make_shared<MultiLoraAdapter>(active);
+        for (size_t i = 0; i < weights.size(); ++i)
+            models_[i]->multiplier = weights[i];
+        return result;
+    }
+
+    void LoraExecution::restore_weights(const std::vector<float>& previous) {
+        for (size_t i = 0; i < previous.size(); ++i)
+            models_[i]->multiplier = previous[i];
     }

