+#include "model/common/lllite.h"
+
+#include <algorithm>
+#include <array>
+#include <map>
+#include <regex>
+#include <set>
+#include <stdexcept>
+#include <string_view>
+
+#include "core/ggml_extend.h"
+#include "core/ggml_runner.h"
+#include "model/common/nui_unet_hooks.hpp"
+#include "model_loader.h"
+
+namespace sd::nui {
+    struct LLLiteTensor {
+        std::array<int64_t, 4> dims{1, 1, 1, 1};
+        int rank = 0;
+        std::vector<float> data;
+
+        ggml_tensor* input(GGMLRunnerContext& ctx) const {
+            auto* value = ggml_new_tensor(ctx.ggml_ctx, GGML_TYPE_F32, rank, dims.data());
+            ctx.set_backend_tensor_data(value, data.data());
+            return value;
+        }
+    };
+
+    struct LLLiteLayer {
+        LLLiteTensor w, b;
+
+        ggml_tensor* conv(GGMLRunnerContext& ctx, ggml_tensor* x) const {
+            const auto stride = int(w.dims[0]);
+            auto* kernel = ggml_cast(ctx.ggml_ctx, w.input(ctx), GGML_TYPE_F16);
+            return ggml_ext_conv_2d(&ctx, x, kernel, b.input(ctx), stride, stride, 0, 0, 1, 1);
+        }
+
+        ggml_tensor* pointwise(GGMLRunnerContext& ctx, ggml_tensor* x) const {
+            auto* graph = ctx.ggml_ctx;
+            auto* weights = w.input(ctx);
+            if (w.rank == 4)
+                weights = ggml_reshape_2d(graph, weights, w.dims[2], w.dims[3]);
+            return ggml_add(graph, ggml_mul_mat(graph, weights, x), b.input(ctx));
+        }
+    };
+
+    struct LLLiteModule {
+        std::vector<LLLiteLayer> conditioning;
+        LLLiteLayer down, mid, up;
+        int reduction = 1;
+    };
+
+    struct LLLiteWeights {
+        std::map<std::string, LLLiteModule, std::less<>> modules;
+    };
+
+    static std::string target_projection(const std::string& module) {
+        static const std::regex pattern(
+            R"(^lllite_unet_(input_blocks_([0-9]+)|middle_block|output_blocks_([0-9]+))_1_transformer_blocks_([0-9]+)_(attn[12])_to_([qkv])$)");
+        std::smatch idx;
+        if (!std::regex_match(module, idx, pattern))
+            return {};
+        const auto block = idx[2].matched ? "input_blocks." + idx[2].str() :
+                           idx[3].matched ? "output_blocks." + idx[3].str() : "middle_block";
+        return block + ".1.transformer_blocks." + idx[4].str() + "." + idx[5].str() + ".to_" + idx[6].str();
+    }
+
+    std::shared_ptr<const LLLiteWeights> load_lllite(const std::string& path) {
+        ModelLoader loader;
+        if (!loader.init_from_file(path))
+            throw std::runtime_error("Could not read ControlNet-LLLite model");
+        const auto& catalog = loader.get_tensor_storage_map();
+        std::map<std::string, std::string> targets;
+        for (const auto& item : catalog) {
+            const auto name = item.first.substr(0, item.first.find('.'));
+            if (targets.count(name))
+                continue;
+            const auto target = target_projection(name);
+            if (!target.empty())
+                targets.emplace(name, target);
+        }
+        if (targets.empty())
+            throw std::runtime_error("ControlNet-LLLite model contains no supported attention projections");
+
+        auto result = std::make_shared<LLLiteWeights>();
+        std::map<std::string, LLLiteTensor*> outputs;
+        const auto allocate = [&](const std::string& name, LLLiteTensor& tensor) {
+            const auto it = catalog.find(name);
+            if (it == catalog.end() || it->second.n_dims < 1 || it->second.n_dims > 4)
+                throw std::runtime_error("Missing or invalid ControlNet-LLLite tensor: " + name);
+            tensor.rank = it->second.n_dims;
+            std::copy_n(it->second.ne, tensor.rank, tensor.dims.begin());
+            int64_t elements = 1;
+            for (int j = 0; j < tensor.rank; ++j) {
+                const auto n = tensor.dims[j];
+                if (n <= 0 || elements > INT64_MAX / n || uint64_t(elements * n) > tensor.data.max_size())
+                    throw std::runtime_error("Invalid ControlNet-LLLite tensor dimensions");
+                elements *= n;
+            }
+            tensor.data.resize(size_t(elements));
+            outputs.emplace(name, &tensor);
+        };
+
+        for (const auto& [name, target] : targets) {
+            auto& module = result->modules[target];
+            const auto layer = [&](const std::string& field, LLLiteLayer& output) {
+                allocate(name + "." + field + ".weight", output.w);
+                allocate(name + "." + field + ".bias", output.b);
+            };
+            const bool deep = catalog.count(name + ".conditioning1.4.weight") != 0;
+            module.conditioning.resize(deep ? 3 : 2);
+            int64_t channels = 3;
+            for (int i = 0; i < int(module.conditioning.size()); ++i) {
+                auto& conv = module.conditioning[i];
+                layer("conditioning1." + std::to_string(i * 2), conv);
+                const auto& dims = conv.w.dims;
+                const int64_t stride = dims[0];
+                if (conv.w.rank != 4 || dims[1] != stride || dims[2] != channels ||
+                    (stride != 2 && stride != 4) || (i == 0 && stride != 4) ||
+                    conv.b.rank != 1 || conv.b.dims[0] != dims[3])
+                    throw std::runtime_error("Invalid ControlNet-LLLite image encoder: " + name);
+                module.reduction *= int(stride);
+                channels = dims[3];
+            }
+            layer("down.0", module.down);
+            layer("mid.0", module.mid);
+            layer("up.0", module.up);
+            const auto sizes = [&](const LLLiteLayer& projection) -> std::pair<int64_t, int64_t> {
+                const auto& dims = projection.w.dims;
+                const auto shape = projection.w.rank == 2 ? std::pair{dims[0], dims[1]} : std::pair{dims[2], dims[3]};
+                const bool pointwise = projection.w.rank == 4 && dims[0] == 1 && dims[1] == 1;
+                if ((projection.w.rank != 2 && !pointwise) || projection.b.rank != 1 || projection.b.dims[0] != shape.second)
+                    throw std::runtime_error("Invalid ControlNet-LLLite pointwise projection: " + name);
+                return shape;
+            };
+            const auto [input, inner] = sizes(module.down);
+            const auto [mid_in, mid_out] = sizes(module.mid);
+            const auto [up_in, up_out] = sizes(module.up);
+            if (mid_in != inner + channels || mid_out != inner || up_in != inner || up_out != input)
+                throw std::runtime_error("ControlNet-LLLite projection dimensions do not connect: " + name);
+        }
+
+        auto* arena = ggml_init({ggml_tensor_overhead() * outputs.size(), nullptr, true});
+        if (!arena)
+            throw std::runtime_error("Could not allocate ControlNet-LLLite tensor metadata");
+        const std::unique_ptr<ggml_context, decltype(&ggml_free)> owner(arena, ggml_free);
+        std::map<std::string, ggml_tensor*> tensors;
+        for (const auto& [name, data] : outputs) {
+            auto* value = ggml_new_tensor(arena, GGML_TYPE_F32, data->rank, data->dims.data());
+            value->data = data->data.data();
+            tensors.emplace(name, value);
+        }
+        if (!loader.load_tensors(tensors, {}, true))
+            throw std::runtime_error("Could not load ControlNet-LLLite weights");
+        return result;
+    }
+
+    ggml_tensor* lllite_projection(GGMLRunnerContext* ctx, ggml_tensor* input, const std::string& layer,
+                                   const char* projection, bool reference_pair) {
+        auto& pass = active;
+        if (!pass.lllite || layer.empty())
+            return input;
+        const auto start = layer.find("diffusion_model.");
+        const auto name = (start == std::string::npos ? layer : layer.substr(start + std::string_view("diffusion_model.").size()))
+                        + "." + projection;
+        const auto& binding = *pass.lllite;
+        const auto& model = *binding.weights;
+        const auto match = model.modules.find(name);
+        if (match == model.modules.end())
+            return input;
+        ++pass.lllite_matched;
+        const auto& module = match->second;
+        const auto& shape = binding.hint->shape();
+        const auto w = shape[0] / module.reduction, h = shape[1] / module.reduction;
+        if (w == 0 || h == 0 || input->ne[1] != w * h * (reference_pair ? 2 : 1))
+            return input;
+        const auto& down = module.down.w;
+        if (input->ne[0] != down.dims[down.rank == 2 ? 0 : 2])
+            throw std::runtime_error("ControlNet-LLLite projection channels do not match the U-Net: " + name);
+
+        auto* graph = ctx->ggml_ctx;
+        const auto cache_key = "lllite." + std::to_string(reinterpret_cast<uintptr_t>(binding.weights.get())) + "." +
+                               std::to_string(reinterpret_cast<uintptr_t>(binding.hint.get())) + "." + name;
+        auto* conditioning = ctx->load_cache_tensor(cache_key);
+        if (!conditioning) {
+            if (!pass.lllite_image) {
+                auto* image = ggml_new_tensor_4d(graph, GGML_TYPE_F32, shape[0], shape[1], 3, 1);
+                ctx->set_backend_tensor_data(image, binding.hint->data());
+                pass.lllite_image = ggml_scale_bias(graph, image, 2.f, -1.f);
+            }
+            auto* image = pass.lllite_image;
+            for (size_t i = 0; i < module.conditioning.size(); ++i) {
+                image = module.conditioning[i].conv(*ctx, image);
+                if (i + 1 < module.conditioning.size())
+                    image = ggml_relu(graph, image);
+            }
+            auto* grid = ggml_reshape_2d(graph, image, w * h, image->ne[2]);
+            conditioning = ggml_cont(graph, ggml_transpose(graph, grid));
+            ctx->persist_cache_tensor(cache_key, conditioning);
+        }
+        conditioning = ggml_repeat_4d(graph, conditioning, conditioning->ne[0], input->ne[1], input->ne[2], 1);
+        auto* downsampled = ggml_relu(graph, module.down.pointwise(*ctx, input));
+        auto* gated = ggml_relu(graph, module.mid.pointwise(*ctx, ggml_concat(graph, conditioning, downsampled, 0)));
+        auto* delta = module.up.pointwise(*ctx, gated);
+        ++pass.lllite_applied;
+        return ggml_add(graph, input, ggml_scale(graph, delta, binding.strength));
+    }
+}
