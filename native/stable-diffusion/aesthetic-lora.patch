+
+    void merge_aesthetic_lora(ggml_backend_t gpu, const std::map<std::string, Tensor>& weights,
+                              SDVersion version, const std::string& path, float multiplier) {
+        auto manager = std::make_shared<ModelManager>();
+        ModelManager::LoraSpec spec;
+        spec.path = path;
+        spec.required = true;
+        std::vector<ModelManager::LoraSpec> specs{spec};
+        if (!manager->prepare_lora_sources(specs))
+            throw std::runtime_error("Cannot load Aesthetic Gradients LoRA: " + path);
+        const auto file = specs.front().file_id;
+        const std::string prefix = std::string("lora.") + clip_prefix;
+        const auto key = [&](const std::string& name) -> std::string {
+            if (!starts_with(name, prefix)) return {};
+            const auto tensor = name.substr(std::string_view("lora.").size());
+            for (std::string_view suffix : {".weight", ".bias"}) {
+                const auto end = tensor.find(std::string(suffix) + ".");
+                if (end != std::string::npos) return tensor.substr(0, end + suffix.size());
+            }
+            return {};
+        };
+        const auto entries = manager->loader().file_tensors(file, version);
+        std::set<std::string> targets;
+        for (const auto& [name, _] : entries) {
+            const auto target = key(name);
+            if (weights.count(target)) targets.insert(target);
+        }
+        if (targets.empty()) return;
+        LoraModel lora(path, gpu, gpu, manager, file, version);
+        lora.multiplier = multiplier;
+        if (!lora.init_params(4, [&](const std::string& name) { return targets.count(key(name)) != 0; }))
+            throw std::runtime_error("Cannot initialize Aesthetic Gradients LoRA: " + path);
+        lora.preprocess_lora_tensors(targets);
+        std::vector<std::pair<Tensor, Tensor>> updates;
+        const auto make_graph = [&]() {
+            updates.clear();
+            auto context = lora.get_context();
+            auto graph = ggml_new_graph_custom(context.ggml_ctx, graph_capacity, false);
+            for (const auto& name : targets) {
+                auto original = weights.at(name);
+                auto delta = lora.get_weight_diff(name, &context, original);
+                if (!delta) continue;
+                delta = ggml_cont(context.ggml_ctx, ggml_ext_cast_f32(&context, delta));
+                ggml_set_output(delta);
+                ggml_build_forward_expand(graph, delta);
+                updates.emplace_back(original, delta);
+            }
+            if (updates.empty()) throw std::runtime_error("No compatible CLIP-L LoRA tensors");
+            return graph;
+        };
+        const auto read_outputs = [&]() {
+            for (const auto& [original, delta] : updates) {
+                const auto adjustment = sd::make_sd_tensor_from_ggml<float>(delta);
+                if (adjustment.empty()) return false;
+                std::vector<float> values(ggml_nelements(original));
+                ggml_backend_tensor_get(original, values.data(), 0, ggml_nbytes(original));
+                for (size_t i = 0; i < values.size(); ++i)
+                    values[i] += adjustment.data()[i];
+                ggml_backend_tensor_set(original, values.data(), 0, ggml_nbytes(original));
+            }
+            return true;
+        };
+        if (!lora.compute(make_graph, 4, true, true, read_outputs).has_value())
+            throw std::runtime_error("Cannot merge Aesthetic Gradients LoRA: " + path);
+        lora.stat(false, "CLIP-L training");
+    }

