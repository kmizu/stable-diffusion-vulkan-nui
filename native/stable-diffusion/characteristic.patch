+#include "characteristic.h"
+
+#include <algorithm>
+#include <cmath>
+#include <deque>
+#include <limits>
+#include <numeric>
+#include <stdexcept>
+
+namespace sd::nui {
+    namespace {
+        using Vector = std::vector<double>;
+
+        double dot(const Vector& a, const Vector& b) {
+            return std::inner_product(a.begin(), a.end(), b.begin(), 0.);
+        }
+
+        void add_scaled(Vector& target, const Vector& source, double scale) {
+            for (size_t i = 0; i < target.size(); ++i)
+                target[i] += source[i] * scale;
+        }
+
+        // A quantile band and its channel select exactly one column at each coordinate.
+        // The columns are disjoint, so the ridge normal matrix is diagonal.
+        class Basis {
+            Vector values_;
+            std::vector<size_t> columns_;
+            Vector norms_;
+
+        public:
+            Basis(const ChgVector& direction, size_t plane, size_t channels, size_t bands)
+                : values_(direction.begin(), direction.end()), columns_(direction.size()),
+                  norms_(bands ? channels * bands : 1) {
+                if (bands) {
+                    for (size_t channel = 0; channel < channels; ++channel) {
+                        const size_t offset = channel * plane;
+                        Vector sorted(values_.begin() + offset, values_.begin() + offset + plane);
+                        std::sort(sorted.begin(), sorted.end(), std::greater<double>());
+                        Vector thresholds;
+                        for (size_t band = 1; band < bands; ++band) {
+                            const double index = double(plane - 1) * band / bands;
+                            const size_t lower = size_t(index);
+                            const double fraction = index - lower;
+                            thresholds.push_back(-(sorted[lower] * (1 - fraction) + sorted[std::min(lower + 1, plane - 1)] * fraction));
+                        }
+                        for (size_t i = offset; i < offset + plane; ++i) {
+                            const auto band = std::upper_bound(thresholds.begin(), thresholds.end(), -values_[i]);
+                            columns_[i] = channel * bands + size_t(band - thresholds.begin());
+                        }
+                    }
+                }
+                for (size_t i = 0; i < values_.size(); ++i)
+                    norms_[columns_[i]] += values_[i] * values_[i];
+                for (double& squared : norms_)
+                    squared = std::max(1e-4, std::sqrt(squared));
+                for (size_t i = 0; i < values_.size(); ++i)
+                    values_[i] /= norms_[columns_[i]];
+                std::fill(norms_.begin(), norms_.end(), 0.);
+                for (size_t i = 0; i < values_.size(); ++i)
+                    norms_[columns_[i]] += values_[i] * values_[i];
+            }
+
+            ChgVector project(const ChgVector& input, double ridge) const {
+                Vector coefficients(norms_.size());
+                for (size_t i = 0; i < input.size(); ++i)
+                    coefficients[columns_[i]] += values_[i] * input[i];
+                for (size_t i = 0; i < norms_.size(); ++i)
+                    coefficients[i] /= std::max(1e-4, norms_[i] + ridge);
+                ChgVector output(input.size());
+                for (size_t i = 0; i < output.size(); ++i)
+                    output[i] = float(values_[i] * coefficients[columns_[i]]);
+                return output;
+            }
+        };
+
+        // Spectral pseudo-inverse of the small symmetric normal matrix for rank-deficient histories.
+        Vector solve_singular(const std::vector<Vector>& columns, const Vector& rhs) {
+            const auto n = columns.size();
+            std::vector<Vector> a(n, Vector(n)), eigen(n, Vector(n));
+            Vector b(n), result(n);
+            for (size_t i = 0; i < n; ++i) {
+                eigen[i][i] = 1;
+                b[i] = dot(columns[i], rhs);
+                for (size_t j = 0; j <= i; ++j)
+                    a[i][j] = a[j][i] = dot(columns[i], columns[j]);
+            }
+            for (int sweep = 0; sweep < 32; ++sweep) {
+                double largest = 0;
+                for (size_t i = 0; i < n; ++i) {
+                    for (size_t j = i + 1; j < n; ++j) {
+                        const double off = a[i][j];
+                        largest = std::max(largest, std::abs(off));
+                        if (std::abs(off) <= 1e-12)
+                            continue;
+                        const double angle = .5 * std::atan2(2 * off, a[j][j] - a[i][i]);
+                        const double c = std::cos(angle), s = std::sin(angle);
+                        const double ai = a[i][i], aj = a[j][j];
+                        a[i][i] = c*c*ai - 2*c*s*off + s*s*aj;
+                        a[j][j] = s*s*ai + 2*c*s*off + c*c*aj;
+                        a[i][j] = a[j][i] = 0;
+                        for (size_t k = 0; k < n; ++k) {
+                            if (k != i && k != j) {
+                                const double ki = a[k][i], kj = a[k][j];
+                                a[k][i] = a[i][k] = c * ki - s * kj;
+                                a[k][j] = a[j][k] = s * ki + c * kj;
+                            }
+                            const double ki = eigen[i][k], kj = eigen[j][k];
+                            eigen[i][k] = c * ki - s * kj;
+                            eigen[j][k] = s * ki + c * kj;
+                        }
+                    }
+                }
+                if (largest <= 1e-12)
+                    break;
+            }
+            for (size_t i = 0; i < n; ++i)
+                add_scaled(result, eigen[i], dot(eigen[i], b) / std::max(a[i][i], 1e-4));
+            return result;
+        }
+
+        Vector least_squares(const std::vector<Vector>& columns, const Vector& rhs) {
+            const auto n = columns.size();
+            auto orthogonal = columns;
+            std::vector<Vector> r(n, Vector(n));
+            Vector result(n);
+            for (size_t j = 0; j < n; ++j) {
+                auto& q = orthogonal[j];
+                // Reorthogonalize to keep nearly collinear residuals well conditioned.
+                for (int pass = 0; pass < 2; ++pass)
+                    for (size_t i = 0; i < j; ++i) {
+                        const double component = dot(q, orthogonal[i]);
+                        r[i][j] += component;
+                        add_scaled(q, orthogonal[i], -component);
+                    }
+                r[j][j] = std::sqrt(dot(q, q));
+                if (r[j][j] <= 1e-8)
+                    return solve_singular(columns, rhs);
+                for (double& element : q)
+                    element /= r[j][j];
+                result[j] = dot(q, rhs);
+            }
+            for (size_t j = n; j-- > 0;) {
+                for (size_t k = j + 1; k < n; ++k)
+                    result[j] -= r[j][k] * result[k];
+                result[j] /= r[j][j];
+            }
+            return result;
+        }
+
+        class Anderson {
+            struct Difference { Vector point, residual; };
+            std::deque<Difference> differences_;
+            Vector previous_point_, previous_residual_;
+            size_t memory_;
+
+        public:
+            explicit Anderson(size_t memory) : memory_(memory) {}
+
+            void accelerate(Vector& point, Vector& residual) {
+                if (!previous_point_.empty()) {
+                    auto dp = point, dr = residual;
+                    add_scaled(dp, previous_point_, -1);
+                    add_scaled(dr, previous_residual_, -1);
+                    differences_.push_back({std::move(dp), std::move(dr)});
+                    if (differences_.size() > memory_)
+                        differences_.pop_front();
+                }
+                previous_point_ = point;
+                previous_residual_ = residual;
+                std::vector<Vector> columns;
+                Vector norms;
+                for (const auto& change : differences_) {
+                    norms.push_back(std::max(1e-4, std::sqrt(dot(change.residual, change.residual))));
+                    auto& column = columns.emplace_back(change.residual);
+                    for (double& value : column)
+                        value /= norms.back();
+                }
+                const auto coefficients = least_squares(columns, residual);
+                for (size_t i = 0; i < columns.size(); ++i) {
+                    add_scaled(point, differences_[i].point, -coefficients[i] / norms[i]);
+                    add_scaled(residual, columns[i], -coefficients[i]);
+                }
+            }
+        };
+
+        bool finite(const ChgVector& v) {
+            return std::all_of(v.begin(), v.end(), [](float x) { return std::isfinite(x); });
+        }
+    }
+
+    ChgResult ChgSolver::solve(const ChgConfig& config, size_t plane, size_t channels,
+                               double alpha, double final_alpha,
+                               const std::function<ChgVector(const ChgVector&)>& direction) {
+        const size_t count = plane * channels;
+        if (!count || !plane || !channels || config.iterations < 1 || config.memory < 1 || config.bins < 0 ||
+            !(alpha > 0 && alpha < 1 && final_alpha > 0 && final_alpha < 1) ||
+            !(config.regularization_range > 0 && config.annealing_strength > 0))
+            throw std::invalid_argument("invalid Characteristic Guidance solver configuration");
+        const auto evaluate = [&](const ChgVector& x) {
+            auto result = direction(x);
+            if (result.size() != count)
+                throw std::invalid_argument("Characteristic Guidance direction changed size");
+            return result;
+        };
+        const ChgVector zero(count);
+        ChgVector x(count);
+        if (previous_.size() == count) {
+            const double factor = config.reuse * (previous_alpha_ / alpha) *
+                                  ((1 - alpha) / (1 - previous_alpha_));
+            for (size_t i = 0; i < count; ++i)
+                x[i] = float(previous_[i] * factor);
+        }
+        const double target = config.regularization * std::pow(final_alpha / alpha, 1 / config.regularization_range);
+        double ridge = std::max(5., config.regularization);
+        ChgResult result{zero, std::numeric_limits<double>::infinity(), target, 0, false};
+        const auto at_zero = evaluate(zero);
+        if (finite(at_zero)) {
+            const Basis basis(at_zero, plane, channels, size_t(config.bins));
+            Anderson history(config.bins ? size_t(config.memory) : 1);
+            for (int i = 0; i < config.iterations; ++i) {
+                ++result.iterations;
+                const bool is_zero = std::all_of(x.begin(), x.end(), [](float value) { return value == 0; });
+                auto field = is_zero ? at_zero : evaluate(x);
+                if (i != 0)
+                    field = basis.project(field, ridge);
+                Vector point(x.begin(), x.end()), residual(count + 1);
+                for (size_t j = 0; j < count; ++j)
+                    residual[j] = point[j] - field[j];
+                const double annealing = std::sqrt(ridge * config.annealing_strength);
+                point.push_back(annealing);
+                residual.back() = config.annealing_speed * (annealing - std::sqrt(target * config.annealing_strength));
+                const auto rms = std::sqrt(dot(residual, residual) / residual.size());
+                if (!std::isfinite(rms))
+                    break;
+                result.residual = std::min(result.residual, rms);
+                if (rms < config.tolerance) {
+                    result.correction = std::move(x);
+                    result.converged = true;
+                    break;
+                }
+                history.accelerate(point, residual);
+                add_scaled(point, residual, -config.step_size);
+                for (size_t j = 0; j < count; ++j)
+                    x[j] = float(point[j]);
+                ridge = point.back() * point.back() / config.annealing_strength;
+            }
+        }
+        previous_ = result.correction;
+        previous_alpha_ = alpha;
+        return result;
+    }
+}
