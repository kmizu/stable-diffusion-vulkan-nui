+    static void apply_cd_tuner_map(Tensor<float>& x, const DiffusionPredictionOptions& options, int step) {
+        const auto& shape = x.shape();
+        const auto& regions = *options.cdt_regions;
+        const auto w = shape[0], h = shape[1], plane = w * h, channels = shape[2];
+        const float attenuation = options.cdt_map_steps < 5 ? 1.15f - options.cdt_map_steps * 0.15f : 0.4f;
+        const float strength = options.cdt_map_strength * 0.5f * attenuation /
+                               (1.f + std::pow(float(1 + step), 1.5f) / 10.f);
+        const auto index = [](float fraction, int64_t dim) {
+            const auto position = int64_t(std::clamp(fraction, -1.f, 1.f) * dim);
+            return position < 0 ? position + dim : position;
+        };
+        for (int64_t r = 0; r < regions.shape()[0]; r += 7) {
+            const auto* cell = regions.data() + r;
+            const auto left = index(cell[0], w), top = index(cell[1], h);
+            const auto right = index(cell[2], w), bottom = index(cell[3], h);
+            const float ratio = 5.f * strength * (std::abs(cell[4]) + std::abs(cell[5]) + std::abs(cell[6]));
+            if (ratio <= 0.f)
+                continue;
+            for (int64_t channel = 1; channel < 4; ++channel) {
+                double magnitude = 0;
+                for (int64_t b = 0; b < shape[3]; ++b) {
+                    const auto* pixels = x.data() + (b * channels + channel) * plane;
+                    for (int64_t i = 0; i < plane; ++i)
+                        magnitude += std::abs(pixels[i]);
+                }
+                const float shift = float(magnitude / (plane * shape[3])) * cell[3 + channel] *
+                                    6.f * ratio * options.cdt_map_sign;
+                for (int64_t b = 0; b < shape[3]; ++b) {
+                    auto* pixels = x.data() + (b * channels + channel) * plane;
+                    for (int64_t row = top; row < bottom; ++row)
+                        for (int64_t col = left; col < right; ++col)
+                            pixels[row * w + col] = pixels[row * w + col] * (1.f - ratio) + shift;
+                }
+            }
+        }
     }

