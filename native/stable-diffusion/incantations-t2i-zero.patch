+#pragma once
+
+#include "model/common/nui_seg.hpp"
+#include "model/common/nui_t2i0_state.h"
+
+namespace sd::nui {
+    inline ggml_tensor* ctnms_suppressed(GGMLRunnerContext* ctx, ggml_tensor* output,
+                                         ggml_tensor* values, ggml_tensor* selected,
+                                         int64_t rows, int64_t cols) {
+        auto* graph = ctx->ggml_ctx;
+        const auto tokens = output->ne[1];
+        const auto count = selected->ne[0];
+        if (rows < 2 || cols < 2 || tokens != rows * cols)
+            throw std::runtime_error("T2I-Zero CTNMS needs a spatial attention grid of at least 2 by 2");
+        auto* scores = ggml_mul_mat(graph, values, output);
+        auto* transposed = ggml_cont(graph, ggml_transpose(graph, scores));
+        auto* picked = ggml_get_rows(graph, transposed, selected);
+        auto* planar = ggml_reshape_3d(graph, picked, cols, rows, count);
+        const float edge = std::exp(-0.5f);
+        const float center = 1.f / (1.f + 2.f * edge);
+        const std::vector<float> kernel{edge * center, center, edge * center};
+        auto* blurred_x = seg_axis(ctx, planar, cols, kernel);
+        auto* vertical = ggml_cont(graph, ggml_transpose(graph, blurred_x));
+        auto* blurred_y = seg_axis(ctx, vertical, rows, kernel);
+        auto* smoothed = ggml_cont(graph, ggml_transpose(graph, blurred_y));
+        auto* by_token = ggml_cont(graph, ggml_transpose(graph, ggml_reshape_2d(graph, smoothed, tokens, count)));
+        // The source uses the winning candidate's ordinal to index the full Value matrix.
+        auto* winner = ggml_argmax(graph, by_token);
+        auto* winners = ggml_get_rows(graph, values, winner);
+        return ggml_mul(graph, output, winners);
+    }
+
+    inline ggml_tensor* t2i0_attention(GGMLRunnerContext* ctx, ggml_tensor* output,
+                                      ggml_tensor* values, const std::string& layer) {
+        const auto* config = active.t2i0;
+        if (!config || values->ne[1] % 77 != 0)
+            return output;
+        const auto sequence = output->ne[1];
+        const auto factor = int64_t(std::sqrt((int64_t(config->width) * config->height) / sequence));
+        if (factor == 0)
+            return output;
+        const auto rows = config->height / factor, cols = config->width / factor;
+        if (rows * cols != sequence)
+            return output;
+        if (config->selected.empty())
+            throw std::runtime_error("T2I-Zero CTNMS needs at least two prompt tokens");
+        if (output->ne[2] != 1 || values->ne[2] != 1 || output->ne[0] != values->ne[0] ||
+            *std::max_element(config->selected.begin(), config->selected.end()) >= values->ne[1])
+            throw std::runtime_error("T2I-Zero CTNMS prompt selection does not match the attention values");
+        auto* graph = ctx->ggml_ctx;
+        auto* ids = ggml_new_tensor_1d(graph, GGML_TYPE_I32, config->selected.size());
+        ctx->bind_backend_tensor_data(ids, config->selected.data());
+        auto* suppressed = ctnms_suppressed(ctx, output, values, ids, rows, cols);
+        if (config->ema > 0.f) {
+            const auto index = config->index(int(active.step));
+            const auto key = "t2i0." + config->branch + "." + layer;
+            auto* prior = index == config->reset ? nullptr : ctx->load_cache_tensor(key);
+            if (!prior && config->history && index != config->reset) {
+                const auto snapshot = config->history->snapshots.find(key);
+                if (snapshot != config->history->snapshots.end()) {
+                    prior = sd::make_ggml_tensor(graph, snapshot->second, false);
+                    ctx->bind_backend_tensor_data(prior, snapshot->second.data());
+                }
+            }
+            if (prior && !ggml_are_same_shape(prior, suppressed))
+                throw std::runtime_error("T2I-Zero CTNMS EMA cannot continue at a different latent size");
+            const auto factor = config->ema / float(1 + index);
+            suppressed = ggml_add(graph, ggml_scale(graph, prior ? prior : output, factor),
+                                  ggml_scale(graph, suppressed, 1.f - factor));
