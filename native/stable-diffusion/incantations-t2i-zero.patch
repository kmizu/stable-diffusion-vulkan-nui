+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <vector>
+
+#include "core/tensor.hpp"
+
+namespace sd::nui {
+    inline Tensor<float> correct_conditioning_by_similarity(
+            const Tensor<float>& input, const std::vector<int64_t>& rows, int64_t token_count,
+            int64_t radius, double threshold, float strength) {
+        const int64_t width = input.shape().at(0), count = input.shape().at(1);
+        const auto high = std::min(token_count + 1, count);
+        const auto percentile = std::clamp(1.0 - std::pow(2.718281, -10 * threshold), 1e-16, 1.0 / (1.0 + 1e-10));
+        const float rank = float(percentile) * float(input.numel() - 1);
+        const auto low_rank = int64_t(std::floor(rank)), high_rank = int64_t(std::ceil(rank));
+        Tensor<float> output(input.shape());
+        std::copy_n(input.data(), input.numel(), output.data());
+        std::vector<float> products(input.numel()), sorted(input.numel());
+        for (const auto row : rows) {
+            if (row < 0 || row >= count)
+                continue;
+            const auto* anchor = input.data() + row * width;
+            for (int64_t i = 0; i < input.numel(); ++i)
+                products[i] = anchor[i % width] * input.data()[i];
+            sorted = products;
+            std::nth_element(sorted.begin(), sorted.begin() + low_rank, sorted.end());
+            const float low = sorted[low_rank];
+            if (high_rank != low_rank)
+                std::nth_element(sorted.begin() + low_rank + 1, sorted.begin() + high_rank, sorted.end());
+            const float cutoff = low + (sorted[high_rank] - low) * (rank - float(low_rank));
+            const float maximum = std::max(0.f, *std::max_element(products.begin(), products.end()));
+            for (int64_t col = 0; col < width; ++col) {
+                float total = 0.f;
+                for (int64_t neighbor = std::max<int64_t>(1, row - radius); neighbor < std::min(high, row + radius + 1); ++neighbor) {
+                    const auto i = neighbor * width + col;
+                    const auto keep = (products[i] > cutoff ? products[i] : 0.f) / (maximum > cutoff ? maximum : 0.f);
+                    total += keep * input.data()[i];
+                }
+                output.data()[row * width + col] = (1.f - strength) * anchor[col] + strength * total;
+            }
+        }
+        return output;
+    }
+}
