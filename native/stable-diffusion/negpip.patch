+    namespace {
+        std::string escape_negpip_text(const std::string& text) {
+            std::string result;
+            for (const auto c : text) {
+                if (c == '\\' || c == '(' || c == ')' || c == '[' || c == ']')
+                    result += '\\';
+                result += c;
+            }
+            return result;
+        }
+
+        std::string negpip_weighted(const std::string& literal, float weight) {
+            if (weight == 1.f)
+                return literal;
+            std::ostringstream result;
+            result.imbue(std::locale::classic());
+            result << '(' << literal << ':' << std::fixed << std::setprecision(50) << weight << ')';
+            return result.str();
+        }
+
+        SDCondition encode_negpip(models::TextEncoder& model, PromptEncodingOptions options) {
+            options.clip_negpip = false;
+            const auto spans = parse_prompt_attention(options.text);
+            std::string clean;
+            std::vector<std::string> targets;
+            for (const auto& [text, weight] : spans) {
+                if (text == "BREAK" && weight == -1.f)
+                    clean += " BREAK ";
+                else if (weight < 0.f && !text.empty())
+                    targets.push_back(negpip_weighted(escape_negpip_text(text), -weight));
+                else if (weight >= 0.f)
+                    clean += negpip_weighted(escape_negpip_text(text), weight);
+            }
+            if (targets.empty())
+                return encode_prompt(model, std::move(options));
+            if (options.raw || options.clip_no_special_tokens || options.media || options.image_bindings ||
+                !model.supports_textual_inversion())
+                throw std::runtime_error("NegPiP requires a padded SD CLIP text encoder");
+            if (targets.size() > 64)
+                throw std::runtime_error("NegPiP supports at most 64 negative terms per prompt");
+            options.text = std::move(clean);
+            auto condition = encode_prompt(model, options);
+            const auto width = condition.c_crossattn.shape()[0];
+            std::vector<float> data;
+            auto append = [&](const Tensor<float>& tensor, size_t from, size_t until, float sign) {
+                for (size_t row = from; row < until; ++row) {
+                    const auto* src = tensor.data() + row*width;
+                    data.insert(data.end(), src, src+width);
+                    data.push_back(sign);
+                }
+            };
+            append(condition.c_crossattn,0,condition.c_crossattn.shape()[1],1.f);
+            options.clip_return_tokens = true;
+            for (auto& target : targets) {
+                options.text = std::move(target);
+                auto term = encode_prompt(model, options);
+                const auto& ids = term.c_clip_ids.values();
+                if (ids.size() != size_t(term.c_crossattn.shape()[1]) || ids.size()%77 != 0)
+                    throw std::runtime_error("NegPiP received an invalid CLIP token sequence");
+                for (size_t offset = 0; offset < ids.size(); offset += 77) {
+                    const auto first = ids.begin()+offset+1;
+                    const auto last = ids.begin()+offset+77;
+                    const auto eos = std::find(first,last,49407);
+                    // Retain the first EOS but omit BOS and padding.
+                    append(term.c_crossattn,offset+1,eos == last ? offset+77 : size_t(eos-ids.begin()+1),-1.f);
+                }
+            }
+            const auto rows = int64_t(data.size()/(width+1));
+            condition.c_crossattn = Tensor<float>({width+1,rows},std::move(data));
+            condition.c_clip_ids = {};
+            return condition;
+        }
+    }
