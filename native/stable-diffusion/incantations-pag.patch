+++ b/src/dgl/ops/nui_pag.h
@@ -0,0 +1,60 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <stdexcept>
+#include <vector>
+
+#include "core/tensor.hpp"
+
+namespace sd::nui {
+    inline void pag_spatial_choice(const Tensor<float>& cfg, const Tensor<float>& pag, Tensor<float>& result) {
+        const auto& shape = cfg.shape();
+        if (shape.size() != 4 || shape[0] < 2 || shape[1] < 2)
+            throw std::runtime_error("Incantations SANF needs a spatial latent of at least 2 by 2");
+        const int64_t width = shape[0], height = shape[1], channels = shape[2];
+        const auto plane = width * height;
+        const float edge = std::exp(-0.5f);
+        const float center = 1.f / (1.f + 2.f * edge);
+        const float weights[] = {edge * center, center, edge * center};
+        std::vector<float> cfg_weights(channels), pag_weights(channels);
+        auto reflect = [](int64_t value, int64_t size) {
+            return value < 0 ? -value : (value >= size ? 2 * size - 2 - value : value);
+        };
+        auto logits = [&](const float* data, int64_t x, int64_t y) {
+            float total = 0.f;
+            for (int dy = -1; dy <= 1; ++dy)
+                for (int dx = -1; dx <= 1; ++dx)
+                    total += weights[dx + 1] * weights[dy + 1] *
+                             std::abs(data[reflect(y + dy, height) * width + reflect(x + dx, width)]);
+            return total;
+        };
+        auto normalize = [](std::vector<float>& values) {
+            const float peak = *std::max_element(values.begin(), values.end());
+            float total = 0.f;
+            for (auto& value : values) {
+                value = std::exp(value - peak);
+                total += value;
+            }
+            for (auto& value : values)
+                value /= total;
+        };
+        for (int64_t b = 0; b < shape[3]; ++b) {
+            for (int64_t y = 0; y < height; ++y) {
+                for (int64_t x = 0; x < width; ++x) {
+                    for (int64_t c = 0; c < channels; ++c) {
+                        const auto offset = (b * channels + c) * plane;
+                        cfg_weights[c] = logits(cfg.data() + offset, x, y);
+                        pag_weights[c] = logits(pag.data() + offset, x, y);
+                    }
+                    normalize(cfg_weights);
+                    normalize(pag_weights);
+                    for (int64_t c = 0; c < channels; ++c) {
+                        const auto i = (b * channels + c) * plane + y * width + x;
+                        result.data()[i] += cfg_weights[c] >= pag_weights[c] ? cfg.data()[i] : pag.data()[i];
+                    }
+                }
+            }
+        }
+    }
+}
